{
    "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
    "targets": ["copilot", "cursor", "claudecode", "codexcli", "opencode", "antigravity-cli"],
    "features": ["*"],
    "sources": [
        {
            "source": "davidvkimball/obsidian-dev-skills:.",
            "features": ["skills"],
            "skills": ["obsidian-dev", "obsidian-ops", "obsidian-ref", "obsidian-theme-dev"],
        },
        {
            "source": "https://github.com/Yungho/obsidian-plugin-dev",
            "transport": "git",
            "path": ".",
            "skills": ["reference"],
        },
        {
            "source": "gapmiss/obsidian-plugin-skill:.agents/skills",
            "features": ["skills"],
            "skills": ["obsidian"],
        },
    ],
    "outputRoots": ["."],
    "delete": true,
    "verbose": false,
    "silent": false,
    "global": false,
    "simulateCommands": false,
    "simulateSubagents": false,
    "simulateSkills": false,
    "gitignoreTargetsOnly": true,
}
